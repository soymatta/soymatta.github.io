---
const { title, place, year, description, titleKey, placeKey, yearKey, descKey } = Astro.props;
---

<div class="flex justify-between items-start gap-8 py-4">
  <div class="flex flex-col">
    <h3 class="text-accent text-2xl font-bold" data-i18n={titleKey}>{title}</h3>
    <span class="text-lg mt-1" data-i18n={placeKey}>{place}</span>
    <span class="text-base text-muted" data-i18n={yearKey}>{year}</span>
  </div>
  <div class="max-w-[500px]">
    <p class="text-base text-muted leading-relaxed" data-i18n={descKey}>{description}</p>
  </div>
</div>
