---
const { title, place, year, description, titleKey, placeKey, yearKey, descKey } = Astro.props;
---

<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 md:gap-8 py-4">
  <div class="flex flex-col shrink-0 md:w-[320px]">
    <h3 class="text-accent text-xl sm:text-2xl font-bold min-h-[1.6em]" data-i18n={titleKey}>{title}</h3>
    <span class="text-base sm:text-lg mt-1" data-i18n={placeKey}>{place}</span>
    <span class="text-sm sm:text-base text-muted" data-i18n={yearKey}>{year}</span>
  </div>
  <div class="max-w-full md:max-w-[500px]">
    <p class="text-sm sm:text-base text-muted leading-relaxed min-h-[4em]" data-i18n={descKey}>{description}</p>
  </div>
</div>
