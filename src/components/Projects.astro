---
import Buttons from "./Buttons.astro";
import GithubIcon from "../images/icon-github.svg?raw";
import LinkIcon from "../images/icon-link.svg?raw";
import PagePreviewTemplate from "../images/PagePreviewTemplate.png";

import PythonIcon from "../images/icon-python.svg?raw";
import DjangoIcon from "../images/icon-django.svg?raw";
import JSIcon from "../images/icon-javascript.svg?raw";
import ReactIcon from "../images/icon-react.svg?raw";
import JavaIcon from "../images/icon-java.svg?raw";
import FlaskIcon from "../images/icon-flask.svg?raw";
import AngularIcon from "../images/icon-angular.svg?raw";
import FlutterIcon from "../images/icon-flutter.svg?raw";
import TailwindIcon from "../images/icon-tailwindcss.svg?raw";
import MysqlIcon from "../images/icon-mysql.svg?raw";
import FirebaseIcon from "../images/icon-firebase.svg?raw";
import SupabaseIcon from "../images/icon-supabase.svg?raw";
import GitIcon from "../images/icon-git.svg?raw";
import PostmanIcon from "../images/icon-postman.svg?raw";

const toolIcons: Record<string, string> = {
  Python: PythonIcon,
  JavaScript: JSIcon,
  Java: JavaIcon,
  Flask: FlaskIcon,
  Django: DjangoIcon,
  React: ReactIcon,
  Angular: AngularIcon,
  Flutter: FlutterIcon,
  "Tailwind CSS": TailwindIcon,
  MySQL: MysqlIcon,
  Firebase: FirebaseIcon,
  Supabase: SupabaseIcon,
  Git: GitIcon,
  Postman: PostmanIcon,
};

const { title, description, repo, demo, tools = [], titleKey, descKey, repoText, demoText, repoKey, demoKey } = Astro.props;
---

<article class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-start py-8">
  <div class="rounded-2xl overflow-hidden bg-card w-full max-w-[320px] sm:max-w-[400px] mx-auto lg:mx-0 lg:max-w-[400px] lg:shrink-0 border border-line">
    <img
      class="w-full h-auto"
      src={PagePreviewTemplate.src}
      alt={title}
      loading="lazy"
    />
  </div>
  <div class="flex-1 min-w-0 w-full">
    <h3 class="text-xl sm:text-2xl text-accent font-bold min-h-[1.8em]" data-i18n={titleKey}>
      {title}
    </h3>
    <p class="text-base sm:text-lg mt-3 text-muted min-h-[5em] sm:min-h-[4em]" data-i18n={descKey}>
      {description}
    </p>

    <div class="flex flex-wrap gap-3 mt-5">
      {
        repo && (
          <Buttons
            icon={GithubIcon}
            text={repoText || "Codigo Repo"}
            href={repo}
            target="_blank"
            type="secondary"
            textKey={repoKey}
          />
        )
      }

      {
        demo && (
          <Buttons
            icon={LinkIcon}
            text={demoText || "Demo"}
            href={demo}
            target="_blank"
            type="secondary"
            textKey={demoKey}
          />
        )
      }
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      {
        tools.map((tool: string) => (
          <Buttons
            icon={toolIcons[tool]}
            text={tool}
            type="ternary"
            static={true}
          />
        ))
      }
    </div>
  </div>
</article>
