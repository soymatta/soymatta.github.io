---
const { image, title, description } = Astro.props;
//
---

<div
  class="flex flex-row rounded-4xl border border-white bg-[#272729] max-w-[200px] h-[50px] items-center p-3 py-7 gap-2"
>
  <img src={image.src} alt="Tool image" width="30px" height="30px" />
  <div>
    <h3 class="font-bold">{title}</h3>
    <p class="text-[#8a8a8a] font-varela">{description}</p>
  </div>
</div>
