---
import Buttons from "./Buttons.astro";
import GithubIcon from "../images/icon-github.svg?raw";
import LinkedinIcon from "../images/icon-linkedin.svg?raw";
---

<footer class="mt-24 bg-footer-bg pt-10 pb-8 rounded-t-[50px]">
  <div class="flex flex-col items-center gap-5">
    <div class="flex gap-4">
      <Buttons
        icon={GithubIcon}
        text=""
        href="https://github.com/soymatta"
        target="_blank"
        type="primary"
      />
      <Buttons
        icon={LinkedinIcon}
        text=""
        href="https://www.linkedin.com/in/mattayassed/"
        target="_blank"
        type="primary"
      />
    </div>

    <div class="flex gap-6">
      <a href="#hero" class="footer-link" data-i18n="nav.about">Sobre mi</a>
      <a href="#studies" class="footer-link" data-i18n="nav.education">Educación</a>
      <a href="#tools" class="footer-link" data-i18n="nav.tools">Herramientas</a>
      <a href="#projects" class="footer-link" data-i18n="nav.projects">Proyectos</a>
      <a href="#contact" class="footer-link" data-i18n="nav.contact">Contacto</a>
    </div>

    <div>
      <p class="text-sm text-muted">
        <span data-i18n="footer.created">Creado por</span> <strong>Yassed Matta</strong>
      </p>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";

  .footer-link {
    @apply font-istok text-sm text-fg no-underline transition-colors duration-200 hover:text-accent;
  }
</style>
