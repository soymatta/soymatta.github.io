---
const {
  icon,
  text,
  href,
  target,
  download,
  type = "primary",
  tooltip,
  id,
  static: staticPill = false,
  textKey,
} = Astro.props;

const styles: Record<string, string> = {
  primary: "bg-fg text-page hover:opacity-80",
  secondary: "bg-accent text-white hover:bg-accent-hover",
  ternary: "bg-card text-fg hover:bg-card-hover border-2 border-line",
};

const baseClass = `${styles[type] || styles.primary} rounded-full px-5 h-[44px] inline-flex items-center gap-2 cursor-pointer transition-colors whitespace-nowrap`;
const tagClass = `${baseClass} no-underline`;
const staticClass = staticPill ? "tool-pill-static" : "";
---

{
  href ? (
    <a
      id={id}
      href={href}
      target={target}
      download={download}
      class={`${tagClass} ${staticClass}`}
      data-tooltip={tooltip}
    >
      {icon && (
        <span class="h-[22px] w-[22px] flex-shrink-0 icon-outline" set:html={icon} />
      )}
      {text && <span data-i18n={textKey}>{text}</span>}
    </a>
  ) : (
    <button id={id} class={`${baseClass} ${staticClass}`} data-tooltip={tooltip}>
      {icon && (
        <span class="h-[22px] w-[22px] flex-shrink-0 icon-outline" set:html={icon} />
      )}
      {text && <span data-i18n={textKey}>{text}</span>}
    </button>
  )
}
