---
import SunIcon from "../images/icon-sun-light.svg?raw";
import MoonIcon from "../images/icon-half-moon.svg?raw";
import FlagUS from "../images/FlagUS.svg?raw";
import FlagES from "../images/FlagES.svg?raw";
import MenuIcon from "../images/icon-menu.svg?raw";
import CloseIcon from "../images/icon-close.svg?raw";
---

<nav
  id="navbar"
  class="fixed top-4 left-1/2 -translate-x-1/2 z-50 items-center gap-1 rounded-full border border-line bg-card/80 px-5 py-2 backdrop-blur-md hidden md:flex"
>
  <a href="#hero" class="nav-link" data-i18n="nav.about">Sobre mi</a>
  <a href="#studies" class="nav-link" data-i18n="nav.education">Educación</a>
  <a href="#tools" class="nav-link" data-i18n="nav.tools">Herramientas</a>
  <a href="#projects" class="nav-link" data-i18n="nav.projects">Proyectos</a>
  <a href="#contact" class="nav-link" data-i18n="nav.contact">Contacto</a>

  <span class="w-px h-5 mx-1.5 bg-line"></span>

  <button
    id="theme-toggle"
    class="flex items-center justify-center w-8 h-8 rounded-full border-none bg-transparent text-fg cursor-pointer transition-colors duration-200 hover:bg-fg/10 p-0"
    aria-label="Cambiar tema"
  >
    <span id="icon-sun" class="hidden icon-outline w-[18px] h-[18px] transition-transform duration-300" set:html={SunIcon} />
    <span id="icon-moon" class="icon-outline w-[18px] h-[18px] transition-transform duration-300" set:html={MoonIcon} />
  </button>

  <button
    id="lang-toggle"
    class="flex items-center justify-center w-8 h-8 rounded-full border-none bg-transparent text-fg cursor-pointer transition-colors duration-200 hover:bg-fg/10 p-0"
    aria-label="Cambiar idioma"
  >
    <span id="flag-es" set:html={FlagES} />
    <span id="flag-us" class="hidden" set:html={FlagUS} />
  </button>
</nav>

<!-- Mobile navbar -->
<nav
  id="navbar-mobile"
  class="fixed top-4 right-4 z-50 flex md:hidden"
>
  <button
    id="mobile-menu-btn"
    class="flex items-center justify-center w-10 h-10 rounded-full border border-line bg-card/80 backdrop-blur-md cursor-pointer transition-colors duration-200 hover:bg-card-hover p-0"
    aria-label="Abrir menú"
  >
    <span id="icon-menu" class="icon-outline w-5 h-5 text-fg" set:html={MenuIcon} />
    <span id="icon-close" class="hidden icon-outline w-5 h-5 text-fg" set:html={CloseIcon} />
  </button>
</nav>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-page/95 backdrop-blur-lg flex flex-col items-center justify-center gap-6 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
  <a href="#hero" class="mobile-nav-link" data-i18n="nav.about">Sobre mi</a>
  <a href="#studies" class="mobile-nav-link" data-i18n="nav.education">Educación</a>
  <a href="#tools" class="mobile-nav-link" data-i18n="nav.tools">Herramientas</a>
  <a href="#projects" class="mobile-nav-link" data-i18n="nav.projects">Proyectos</a>
  <a href="#contact" class="mobile-nav-link" data-i18n="nav.contact">Contacto</a>

  <span class="w-12 h-px bg-line my-2"></span>

  <div class="flex items-center gap-4">
    <button
      id="theme-toggle-mobile"
      class="flex items-center justify-center w-10 h-10 rounded-full border border-line bg-card text-fg cursor-pointer transition-colors duration-200 hover:bg-card-hover p-0"
      aria-label="Cambiar tema"
    >
      <span id="icon-sun-mobile" class="hidden icon-outline w-5 h-5 transition-transform duration-300" set:html={SunIcon} />
      <span id="icon-moon-mobile" class="icon-outline w-5 h-5 transition-transform duration-300" set:html={MoonIcon} />
    </button>

    <button
      id="lang-toggle-mobile"
      class="flex items-center justify-center w-10 h-10 rounded-full border border-line bg-card text-fg cursor-pointer transition-colors duration-200 hover:bg-card-hover p-0"
      aria-label="Cambiar idioma"
    >
      <span id="flag-es-mobile" set:html={FlagES} />
      <span id="flag-us-mobile" class="hidden" set:html={FlagUS} />
    </button>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply font-istok text-sm text-fg no-underline px-3 py-1 rounded-full transition-colors duration-200 hover:bg-fg/10 min-w-[80px] text-center whitespace-nowrap;
  }

  .mobile-nav-link {
    @apply font-istok text-2xl text-fg no-underline px-6 py-2 rounded-full transition-colors duration-200 hover:bg-fg/10;
  }
</style>
