---
import "../styles/global.css";

// Components
import Navbar from "../components/Navbar.astro";
import Projects from "../components/Projects.astro";
import Studies from "../components/Studies.astro";
import ToolsPills from "../components/ToolsPills.astro";
import Buttons from "../components/Buttons.astro";
import Footer from "../components/Footer.astro";

// Icons
import CopyIcon from "../images/icon-copy.svg?raw";
import CVIcon from "../images/icon-download.svg?raw";
import GithubIcon from "../images/icon-github.svg?raw";
import LinkedinIcon from "../images/icon-linkedin.svg?raw";
import MailIcon from "../images/icon-mail.svg?raw";
import PhoneIcon from "../images/icon-phone.svg?raw";
import LocationIcon from "../images/icon-map-pin.svg?raw";
import SendIcon from "../images/icon-send.svg?raw";
import BookIcon from "../images/icon-book.svg?raw";
import CodeIcon from "../images/icon-code.svg?raw";

// Tool icons (devicon)
import PythonIcon from "../images/icon-python.svg?raw";
import JSIcon from "../images/icon-javascript.svg?raw";
import JavaIcon from "../images/icon-java.svg?raw";
import FlaskIcon from "../images/icon-flask.svg?raw";
import DjangoIcon from "../images/icon-django.svg?raw";
import ReactIcon from "../images/icon-react.svg?raw";
import AngularIcon from "../images/icon-angular.svg?raw";
import FlutterIcon from "../images/icon-flutter.svg?raw";
import TailwindIcon from "../images/icon-tailwindcss.svg?raw";
import MysqlIcon from "../images/icon-mysql.svg?raw";
import FirebaseIcon from "../images/icon-firebase.svg?raw";
import SupabaseIcon from "../images/icon-supabase.svg?raw";
import GitIcon from "../images/icon-git.svg?raw";
import PostmanIcon from "../images/icon-postman.svg?raw";

// Images
import MeCharacter from "../images/MeCharacter.png";

const inputClass =
  "bg-card border-2 border-accent rounded-xl px-4 py-3 text-fg font-varela text-base outline-none transition-colors duration-200 focus:border-accent focus:ring-2 focus:ring-accent/20 placeholder:text-muted";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yassed Matta | Desarrollador Fullstack</title>
    <meta
      name="description"
      content="Portfolio de Yassed Matta — Desarrollador Web y Mobile Fullstack. Python, JavaScript, TypeScript, React, Django, Node.js, Astro."
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content="Yassed Matta | Desarrollador Fullstack" />
    <meta
      property="og:description"
      content="Portfolio de Yassed Matta — Desarrollador Web y Mobile Fullstack"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://soymatta.github.io/" />
    <meta
      property="og:image"
      content="https://soymatta.github.io/MeCharacter.png"
    />
    <link rel="canonical" href="https://soymatta.github.io/" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Yassed Matta",
      "jobTitle": "Desarrollador Fullstack",
      "url": "https://soymatta.github.io/",
      "email": "yassed883@gmail.com",
      "sameAs": [
        "https://github.com/soymatta",
        "https://www.linkedin.com/in/mattayassed/"
      ]
    })} />
  </head>
  <body>
    <Navbar />

    <main class="px-5 sm:px-8 md:px-12 lg:px-20 xl:px-40">
      <!-- ========== HERO ========== -->
      <section id="hero" class="flex flex-col lg:flex-row items-center justify-center lg:justify-between lg:min-h-screen gap-4 lg:gap-0 pt-14 lg:pt-0">
        <div class="flex-1 w-full lg:max-w-[600px] text-center lg:text-left">
          <h1 class="animate-fade-in-left min-h-[3.6em] lg:min-h-[2.4em] mt-4 lg:mt-0" data-i18n="hero.title">¡Hola, soy Yassed Matta!</h1>
          <p class="text-base sm:text-lg text-muted mt-1 lg:mt-4 animate-fade-in-left delay-1 min-h-[4.5em] lg:min-h-[3em]" data-i18n="hero.subtitle">
            Programador Web y Mobile con conocimientos en desarrollo Fullstack.
            Especializado en Python, JavaScript, frameworks modernos y bases de datos.
          </p>
          <div class="flex flex-wrap gap-3 mt-3 lg:mt-8 animate-fade-in-up delay-2 justify-center lg:justify-start">
            <Buttons
              icon={GithubIcon}
              text="Github"
              href="https://github.com/soymatta"
              target="_blank"
              type="primary"
              textKey="hero.github"
            />
            <Buttons
              icon={LinkedinIcon}
              text="Linkedin"
              href="https://www.linkedin.com/in/mattayassed/"
              target="_blank"
              type="primary"
              textKey="hero.linkedin"
            />
          </div>
          <div class="flex flex-wrap gap-3 mt-3 animate-fade-in-up delay-3 justify-center lg:justify-start">
            <Buttons
              id="cv-btn"
              icon={CVIcon}
              text="Descargar CV"
              type="secondary"
              textKey="hero.cv"
            />
            <div
              class="group relative inline-flex flex-col items-start gap-2"
            >
              <Buttons
                id="email-btn"
                icon={MailIcon}
                text="yassed883@gmail.com"
                type="secondary"
              />
              <div
                class="opacity-0 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300"
              >
                <Buttons
                  id="copy-btn"
                  icon={CopyIcon}
                  text="Click para copiar"
                  type="ternary"
                  textKey="hero.copy"
                />
              </div>
            </div>
          </div>
        </div>
        <div
          class="shrink-0 rounded-full bg-white p-3 sm:p-4 flex items-center justify-center animate-fade-in-right animate-float"
          id="hero-circle"
        >
          <img
            class="w-52 h-52 sm:w-48 sm:h-48 md:w-64 md:h-64 lg:w-80 lg:h-80 rounded-full object-contain"
            src={MeCharacter.src}
            alt="Yassed Matta"
          />
        </div>
      </section>

      <!-- ========== ESTUDIOS ========== -->
      <section id="studies" class="mt-24">
        <h2 class="flex items-center gap-3 reveal">
          <span class="w-10 h-10 shrink-0 icon-outline" set:html={BookIcon} />
          <span data-i18n="studies.title">Estudios</span>
        </h2>
        <div class="mt-6 space-y-6">
          <Studies
            title="Especialización en Seguridad Informática"
            place="Corporación Universitaria Americana"
            year="2025 - Actualmente"
            description="Formación avanzada en ciberseguridad que abarca ética y aspectos legales, fundamentos de ciberseguridad, técnicas de pentesting, criptografía y auditoría de sistemas. Enfocada en la protección de infraestructuras tecnológicas y la detección de vulnerabilidades."
            titleKey="studies.s1.title"
            placeKey="studies.s1.place"
            yearKey="studies.s1.year"
            descKey="studies.s1.desc"
          />
          <Studies
            title="Ingeniería de Sistemas"
            place="Universidad Libre de Barranquilla"
            year="2020 - 2025"
            description="Profesional en Ingeniería de Sistemas con formación en desarrollo de software, arquitectura de bases de datos, redes de computadoras, inteligencia artificial y gestión de proyectos. Capacitado para diseñar, desarrollar e implementar soluciones tecnológicas integrales."
            titleKey="studies.s2.title"
            placeKey="studies.s2.place"
            yearKey="studies.s2.year"
            descKey="studies.s2.desc"
          />
          <Studies
            title="Bachiller Técnico en Electrónica"
            place="Instituto Técnico Industrial Blas Torres de la Torre (ITIDA)"
            year="2013 - 2020"
            description="Formación técnica en electrónica con bases sólidas en circuitos, microcontroladores, sistemas embebidos y programación de bajo nivel. Fundamentos que fortalecen la comprensión del hardware en el desarrollo de software."
            titleKey="studies.s3.title"
            placeKey="studies.s3.place"
            yearKey="studies.s3.year"
            descKey="studies.s3.desc"
          />
        </div>
      </section>

      <!-- ========== HABILIDADES ========== -->
      <section id="tools" class="mt-24">
        <h2 class="reveal" data-i18n="tools.languages">Lenguajes</h2>
        <div class="flex flex-wrap gap-4 mt-5">
          <ToolsPills icon={PythonIcon} description="Propósito general" title="Python" descKey="tools.python_desc" />
          <ToolsPills icon={JSIcon} description="Frontend / Backend" title="JavaScript" descKey="tools.js_desc" />
          <ToolsPills icon={JavaIcon} description="Backend" title="Java" descKey="tools.java_desc" />
        </div>

        <h2 class="mt-14 reveal" data-i18n="tools.frameworks">Frameworks y Librerías</h2>
        <div class="flex flex-wrap gap-4 mt-5">
          <ToolsPills icon={FlaskIcon} description="Backend Python" title="Flask" descKey="tools.flask_desc" />
          <ToolsPills icon={DjangoIcon} description="Backend Python" title="Django" descKey="tools.django_desc" />
          <ToolsPills icon={ReactIcon} description="Frontend" title="React" descKey="tools.react_desc" />
          <ToolsPills icon={AngularIcon} description="Frontend" title="Angular" descKey="tools.angular_desc" />
          <ToolsPills icon={FlutterIcon} description="Mobile" title="Flutter" descKey="tools.flutter_desc" />
          <ToolsPills icon={TailwindIcon} description="CSS Utility" title="Tailwind CSS" descKey="tools.tailwind_desc" />
        </div>

        <h2 class="mt-14 reveal" data-i18n="tools.databases">Bases de datos y Backend</h2>
        <div class="flex flex-wrap gap-4 mt-5">
          <ToolsPills icon={MysqlIcon} description="Base de datos relacional" title="MySQL" descKey="tools.mysql_desc" />
          <ToolsPills icon={FirebaseIcon} description="Backend as a Service" title="Firebase" descKey="tools.firebase_desc" />
          <ToolsPills icon={SupabaseIcon} description="Backend as a Service" title="Supabase" descKey="tools.supabase_desc" />
        </div>

        <h2 class="mt-14 reveal" data-i18n="tools.devtools">Herramientas</h2>
        <div class="flex flex-wrap gap-4 mt-5">
          <ToolsPills icon={GitIcon} description="Control de versiones" title="Git" descKey="tools.git_desc" />
          <ToolsPills icon={PostmanIcon} description="API Testing" title="Postman" descKey="tools.postman_desc" />
        </div>
      </section>

      <!-- ========== PROYECTOS ========== -->
      <section id="projects" class="mt-24">
        <h2 class="flex items-center gap-3 reveal">
          <span class="w-10 h-10 shrink-0 icon-outline" set:html={CodeIcon} />
          <span data-i18n="projects.title">Proyectos</span>
        </h2>
        <div class="mt-6 space-y-8">
          <Projects
            title="Aplicación Móvil de Reciclaje"
            description="Aplicación móvil orientada a la sostenibilidad ambiental. Implementación del flujo de autenticación completa, sincronización de base de datos en la nube en tiempo real utilizando Firebase, y gestión de usuarios. Obtuvo el 1.er Puesto en Competencia de Desarrollo."
            repo="https://github.com/soymatta"
            demo="https://github.com/soymatta"
            tools={["Flutter", "Firebase"]}
            titleKey="projects.p1.title"
            descKey="projects.p1.desc"
            repoText="Código Repo"
            demoText="Demo"
            repoKey="projects.p1.repo"
            demoKey="projects.p1.demo"
          />
          <Projects
            title="Plataforma E-Shop"
            description="Plataforma de comercio electrónico con arquitectura robusta utilizando Flask para la lógica de servidor, MySQL para la gestión relacional de datos y un sistema de autenticación de usuarios. Obtuvo el 2.º Puesto en Competencia de Desarrollo."
            repo="https://github.com/soymatta"
            demo="https://github.com/soymatta"
            tools={["Python", "Flask", "MySQL"]}
            titleKey="projects.p2.title"
            descKey="projects.p2.desc"
            repoText="Código Repo"
            demoText="Demo"
            repoKey="projects.p2.repo"
            demoKey="projects.p2.demo"
          />
        </div>
      </section>

      <!-- ========== CONTACTO ========== -->
      <section id="contact" class="mt-24 mb-12">
        <h2 class="flex items-center gap-3 reveal">
          <span class="w-10 h-10 shrink-0 icon-outline" set:html={MailIcon} />
          <span data-i18n="contact.title">Contacto</span>
        </h2>
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 mt-8">
          <!-- Left: Info -->
          <div class="flex-1 flex flex-col justify-center">
            <h3
              class="font-bold text-2xl sm:text-3xl text-fg inline-block border-b-[3px] border-accent pb-1 self-start min-h-[1.4em]"
              data-i18n="contact.heading"
            >
              ¡Contáctame!
            </h3>
            <p class="text-sm sm:text-base mt-4 text-muted leading-relaxed min-h-[4.5em]" data-i18n="contact.desc">
              Si deseas que forme parte de tu equipo, tienes alguna duda o
              propuesta sobre mi trabajo, puedes contactarme por el formulario o
              con estos datos:
            </p>
            <div class="flex flex-col gap-5 mt-8">
              <div class="flex items-center gap-3">
                <span set:html={MailIcon} class="shrink-0 w-6 h-6 text-accent icon-outline" />
                <span>yassed883@gmail.com</span>
              </div>
              <div class="flex items-center gap-3">
                <span
                  set:html={PhoneIcon}
                  class="shrink-0 w-6 h-6 text-accent icon-outline"></span>
                <span>+57 304 536 4492</span>
              </div>
              <div class="flex items-center gap-3">
                <span
                  set:html={LocationIcon}
                  class="shrink-0 w-6 h-6 text-accent icon-outline"></span>
                <span>Barranquilla / Colombia</span>
              </div>
            </div>
          </div>

          <!-- Right: Form -->
          <div class="flex-1">
            <form
              id="contact-form"
              action="https://formspree.io/f/mqkrwzog"
              method="POST"
              class="flex flex-col gap-5"
            >
              <!-- Honeypot anti-spam -->
              <input
                type="text"
                name="_gotcha"
                class="sr-only"
                tabindex="-1"
                autocomplete="off"
              />

              <!-- Time check -->
              <input type="hidden" id="form-start" name="_timestamp" value="" />

              <div class="flex flex-col gap-1.5">
                <label class="font-istok text-sm font-bold text-fg uppercase tracking-wide" data-i18n="contact.name">Nombre</label>
                <input
                  type="text"
                  name="nombre"
                  data-placeholder="contact.name_ph"
                  placeholder="Escribe tu nombre completo"
                  required
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="font-istok text-sm font-bold text-fg uppercase tracking-wide">Email</label>
                <input
                  type="email"
                  name="email"
                  placeholder="tu@email.com"
                  required
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="font-istok text-sm font-bold text-fg uppercase tracking-wide" data-i18n="contact.subject">Asunto</label>
                <input
                  type="text"
                  name="asunto"
                  data-placeholder="contact.subject_ph"
                  placeholder="¿En qué puedo ayudarte?"
                  required
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class="font-istok text-sm font-bold text-fg uppercase tracking-wide" data-i18n="contact.message">Mensaje</label>
                <textarea
                  name="mensaje"
                  data-placeholder="contact.message_ph"
                  placeholder="Escribe tu mensaje aquí..."
                  rows="5"
                  required
                  class={`${inputClass} resize-none`}></textarea>
              </div>

              <!-- Math captcha -->
              <div class="flex flex-col gap-2">
                <label class="font-istok text-sm font-bold text-fg uppercase tracking-wide">
                  <span data-i18n="contact.captcha">¿Cuánto es</span> <span id="math-a"></span> + <span id="math-b"></span>?
                </label>
                <input
                  type="number"
                  name="_answer"
                  id="math-answer"
                  data-placeholder="contact.answer_ph"
                  placeholder="Respuesta"
                  required
                  class={inputClass}
                />
              </div>

              <div class="flex justify-start mt-1">
                <Buttons icon={SendIcon} text="Enviar" type="secondary" id="send-btn" textKey="contact.send" />
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

