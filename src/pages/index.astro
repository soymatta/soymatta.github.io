  // ===== CV DOWNLOAD =====
  function initCV() {
    const cvBtn = document.getElementById("cv-btn") as HTMLAnchorElement | null;
    if (!cvBtn) return;

    const updateCV = (lang: string) => {
      const href = lang === "en" ? "/EN_Yassed Matta.pdf" : "/ES_Yassed Matta.pdf";
      cvBtn.href = href;
      cvBtn.download = href.split("/").pop() || "";
    };

    updateCV(localStorage.getItem("lang") || "es");

    const langBtn = document.getElementById("lang-toggle");
    langBtn?.addEventListener("click", () => {
      setTimeout(() => {
        const newLang = localStorage.getItem("lang") || "es";
        updateCV(newLang);
      }, 0);
    });

    const langBtnMobile = document.getElementById("lang-toggle-mobile");
    langBtnMobile?.addEventListener("click", () => {
      setTimeout(() => {
        const newLang = localStorage.getItem("lang") || "es";
        updateCV(newLang);
      }, 0);
    });
  }

  // ===== MOBILE MENU =====
  function initMobileMenu() {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (!menuBtn || !mobileMenu) return;

    const toggle = () => {
      const isOpen = !mobileMenu.classList.contains("pointer-events-none");

      if (isOpen) {
        mobileMenu.classList.add("opacity-0", "pointer-events-none");
        mobileMenu.classList.remove("opacity-100", "pointer-events-auto");
        iconMenu?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      } else {
        mobileMenu.classList.remove("opacity-0", "pointer-events-none");
        mobileMenu.classList.add("opacity-100", "pointer-events-auto");
        iconMenu?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
      }
    };

    menuBtn.addEventListener("click", toggle);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (!mobileMenu.classList.contains("pointer-events-none")) {
          toggle();
        }
      });
    });

    const themeBtnMobile = document.getElementById("theme-toggle-mobile");
    themeBtnMobile?.addEventListener("click", () => {
      const desktopBtn = document.getElementById("theme-toggle");
      desktopBtn?.click();
      const isLight = document.documentElement.classList.contains("light");
      const iconSunM = document.getElementById("icon-sun-mobile");
      const iconMoonM = document.getElementById("icon-moon-mobile");
      iconSunM?.classList.toggle("hidden", !isLight);
      iconMoonM?.classList.toggle("hidden", isLight);
    });

    const langBtnMobile = document.getElementById("lang-toggle-mobile");
    langBtnMobile?.addEventListener("click", () => {
      const desktopBtn = document.getElementById("lang-toggle");
      desktopBtn?.click();
      const isEsVisible = !document.getElementById("flag-es")?.classList.contains("hidden");
      document.getElementById("flag-es-mobile")?.classList.toggle("hidden", !isEsVisible);
      document.getElementById("flag-us-mobile")?.classList.toggle("hidden", isEsVisible);
    });
  }

  // ===== THEME =====
  function initTheme() {
    const root = document.documentElement;
    const themeBtn = document.getElementById("theme-toggle");
    const iconSun = document.getElementById("icon-sun");
    const iconMoon = document.getElementById("icon-moon");
    const heroCircle = document.getElementById("hero-circle");

    const savedTheme = localStorage.getItem("theme") || "dark";
    if (savedTheme === "light") {
      root.classList.add("light");
      iconSun?.classList.remove("hidden");
      iconMoon?.classList.add("hidden");
      document.getElementById("icon-sun-mobile")?.classList.remove("hidden");
      document.getElementById("icon-moon-mobile")?.classList.add("hidden");
      if (heroCircle) {
        heroCircle.classList.remove("bg-white");
        heroCircle.classList.add("bg-black");
      }
    }

    themeBtn?.addEventListener("click", () => {
      const btn = themeBtn;
      btn.style.transform = "rotate(360deg)";
      setTimeout(() => { btn.style.transform = ""; }, 300);

      root.classList.toggle("light");
      const isLight = root.classList.contains("light");
      localStorage.setItem("theme", isLight ? "light" : "dark");
      iconSun?.classList.toggle("hidden", !isLight);
      iconMoon?.classList.toggle("hidden", isLight);

      if (heroCircle) {
        if (isLight) {
          heroCircle.classList.remove("bg-white");
          heroCircle.classList.add("bg-black");
        } else {
          heroCircle.classList.remove("bg-black");
          heroCircle.classList.add("bg-white");
        }
      }
    });
  }

  // ===== LANGUAGE =====
  function applyLang(lang: string) {
    const t = translations[lang] || translations.es;
    document.documentElement.lang = lang;

    // Translate all data-i18n elements
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (key && t[key]) {
        el.textContent = t[key];
      }
    });

    // Translate placeholders
    document.querySelectorAll("[data-placeholder]").forEach((el) => {
      const key = el.getAttribute("data-placeholder");
      if (key && t[key]) {
        (el as HTMLInputElement).placeholder = t[key];
      }
    });
  }

  function initLang() {
    const langBtn = document.getElementById("lang-toggle");
    const flagEs = document.getElementById("flag-es");
    const flagUs = document.getElementById("flag-us");

    const savedLang = localStorage.getItem("lang") || "es";
    if (savedLang === "en") {
      flagEs?.classList.add("hidden");
      flagUs?.classList.remove("hidden");
      document.getElementById("flag-es-mobile")?.classList.add("hidden");
      document.getElementById("flag-us-mobile")?.classList.remove("hidden");
    }
    applyLang(savedLang);

    langBtn?.addEventListener("click", () => {
      const isEsVisible = !flagEs?.classList.contains("hidden");
      const newLang = isEsVisible ? "en" : "es";
      flagEs?.classList.toggle("hidden", isEsVisible);
      flagUs?.classList.toggle("hidden", !isEsVisible);
      localStorage.setItem("lang", newLang);
      applyLang(newLang);
    });
  }

  // ===== COPY EMAIL =====
  function initCopyEmail() {
    const copyBtn = document.getElementById("copy-btn");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText("yassed883@gmail.com");
      const textSpan = copyBtn.querySelector("span:last-child");
      const lang = localStorage.getItem("lang") || "es";
      if (textSpan) textSpan.textContent = translations[lang]?.["hero.copied"] || "¡Copiado!";
      setTimeout(() => {
        if (textSpan) textSpan.textContent = translations[lang]?.["hero.copy"] || "Click para copiar";
      }, 2000);
    });
  }

  // ===== CONTACT FORM =====
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const mathA = document.getElementById("math-a");
    const mathB = document.getElementById("math-b");
    const startTime = document.getElementById("form-start") as HTMLInputElement;

    if (!form) return;

    const a = Math.floor(Math.random() * 20) + 1;
    const b = Math.floor(Math.random() * 20) + 1;
    if (mathA) mathA.textContent = String(a);
    if (mathB) mathB.textContent = String(b);
    if (startTime) startTime.value = String(Date.now());

    form.addEventListener("submit", (e) => {
      const elapsed = Date.now() - Number(startTime.value);
      const lang = localStorage.getItem("lang") || "es";
      if (elapsed < 3000) {
        e.preventDefault();
        alert(translations[lang]?.["contact.wait"] || "Por favor espera un momento antes de enviar.");
        return;
      }

      const answer = document.getElementById("math-answer") as HTMLInputElement;
      if (Number(answer?.value) !== a + b) {
        e.preventDefault();
        alert(translations[lang]?.["contact.wrong"] || "Respuesta matemática incorrecta.");
      }
    });
  }

  // ===== SCROLL REVEAL =====
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  }

  // ===== INIT ALL =====
  function initAll() {
    initTheme();
    initLang();
    initCV();
    initCopyEmail();
    initContactForm();
    initReveal();
    initMobileMenu();
  }

  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>
