---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Yassed Matta</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://soymatta.github.io/" />
  </head>
  <body>
    <Navbar />
    <main class="px-5 sm:px-8 md:px-12 lg:px-20 xl:px-40">
      <section class="flex flex-col items-center justify-center min-h-screen text-center gap-6">
        <h1 class="text-8xl font-bold text-accent">404</h1>
        <p class="text-xl text-muted">Página no encontrada</p>
        <a
          href="/"
          class="bg-accent text-white rounded-full px-6 py-3 font-istok font-bold no-underline transition-colors hover:bg-accent-hover"
        >
          Volver al inicio
        </a>
      </section>
    </main>
    <Footer />
  </body>
</html>
